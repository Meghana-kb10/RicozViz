{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@repo/api#build": {
      "cache": false
    },
    "@repo/components#build": {
      "cache": false
    },
    "@repo/database#build": {
      "cache": false
    },
    "@repo/types#build": {
      "cache": false
    },
    "@repo/utils#build": {
      "cache": false
    },
    "@repo/validation#build": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
