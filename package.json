{
  "name": "core-mono-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@repo/*",
    "build:backend": "turbo run build --filter=backend",
    "build:next": "turbo run build --filter=next",
    "build:vite": "turbo run build --filter=vite-app",
    "build:customer": "turbo run build --filter=ricozviz-customer",
    "build:ricozviz": "turbo run build --filter=ricozviz-customer",
    "build:api": "turbo run build --filter=@repo/api",
    "build:components": "turbo run build --filter=@repo/components",
    "build:database": "turbo run build --filter=@repo/database",
    "build:types": "turbo run build --filter=@repo/types",
    "build:utils": "turbo run build --filter=@repo/utils",
    "build:validation": "turbo run build --filter=@repo/validation",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:next": "turbo run dev --filter=next",
    "dev:vite": "turbo run dev --filter=vite-app",
    "dev:customer": "turbo run dev --filter=ricozviz-customer",
    "dev:ricozviz": "turbo run dev --filter=ricozviz-customer",
    "start:backend": "pnpm --filter backend start",
    "start:next": "pnpm --filter next start",
    "start:vite": "pnpm --filter vite-app preview",
    "start:customer": "pnpm --filter ricozviz-customer start",
    "start:ricozviz": "pnpm --filter ricozviz-customer start",
    "preview:vite": "pnpm --filter vite-app preview",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "changeset git-tag && git push --tags",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.26.0"
}