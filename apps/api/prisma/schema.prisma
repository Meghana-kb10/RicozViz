# Prisma Schema — RicozViz
# ========================================
# Foundation configuration only.
# Entity models will be added in Day 1 Step 3 (Database & Schema).
# ========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

