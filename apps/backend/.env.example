# ==============================================================================
# RicozViz Enterprise Intelligence OS — Backend Environment Variables
# ==============================================================================
# Required for production and local development.
# Generate 256-bit cryptographic keys using: openssl rand -hex 32
# ==============================================================================

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ricozviz
MONGODB_DB_NAME=ricozviz

# HTTP Security & CORS
# In production, specify exact trusted frontend domains (wildcard '*' is forbidden in prod)
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000
MAX_UPLOAD_SIZE_BYTES=15728640

# Zero-Trust Authentication Tokens (Required, min 32 chars)
# openssl rand -hex 32
JWT_SECRET=your-32-byte-secret-here-replace-with-openssl-rand-hex-32
JWT_ACCESS_SECRET=your-32-byte-access-secret-replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=your-32-byte-refresh-secret-replace-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Credential Encryption at Rest (Required for AES-256-GCM, 64-character hex string)
# openssl rand -hex 32
CREDENTIAL_ENC_KEY=your-64-character-hex-encryption-key-for-aes-256-gcm-at-rest
CREDENTIAL_ENC_KEY_VERSION=1
# Comma-separated list of previous keys for seamless rotation e.g. "1:0123...def,2:4567...89a"
CREDENTIAL_ENC_KEYS_PREVIOUS=

# Outbound Alert Transports (Optional)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.mailgun.org
SMTP_PASS=your-smtp-password
SMTP_FROM="RicozViz Alerts <alerts@your-domain.io>"
SLACK_WEBHOOK_URL=

# AI NL-to-Chart Provider (Optional - Anthropic or Google Gemini)
LLM_PROVIDER=anthropic
LLM_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-3-5-sonnet-latest
