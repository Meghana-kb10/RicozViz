# ==============================================================================
# RicozViz Fastify API & Worker — Environment Configuration
# ==============================================================================
# Generate keys: openssl rand -hex 32
# In NODE_ENV=test, MONGODB_URI database name MUST end with '_test'.
# ==============================================================================

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB 7.0 Connection
MONGODB_URI=mongodb://127.0.0.1:27017/ricozviz
MONGODB_DB_NAME=ricozviz

# Redis 7 (Presence, Rate-Limiting, Job Locks)
REDIS_URL=redis://127.0.0.1:6379

# HTTP Security & CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://ricozviz.localhost,http://admin.ricozviz.localhost,https://ricozviz.localhost,https://admin.ricozviz.localhost
ALLOWED_ORIGIN=http://localhost:3001,http://localhost:3002,http://ricozviz.localhost,http://admin.ricozviz.localhost,https://ricozviz.localhost,https://admin.ricozviz.localhost
WEB_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002
MAX_UPLOAD_SIZE_BYTES=15728640

# Customer JWT Authentication (aud: "customer", separate from admin)
JWT_SECRET=super_secret_jwt_key_at_least_32_bytes_long_customer_prod
JWT_ACCESS_SECRET=super_secret_jwt_key_at_least_32_bytes_long_customer_prod
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_bytes_long_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Platform Admin JWT Authentication (aud: "admin", role: "PLATFORM_ADMIN")
JWT_ADMIN_SECRET=c1b33bb340e34b62e9e9370df7dbf760c020f0e27b85b5612bf629e8d6874799

# Credential Vault AES-256-GCM Envelope Encryption Keys
ENCRYPTION_MASTER_KEY_V1=f4b321a5c689de701234567890abcdef1234567890abcdef1234567890abcdef
ACTIVE_ENCRYPTION_KEY_VERSION=1
CREDENTIAL_ENC_KEY=f4b321a5c689de701234567890abcdef1234567890abcdef1234567890abcdef
CREDENTIAL_ENC_KEY_VERSION=1
CREDENTIAL_ENC_KEYS_PREVIOUS=

# Outbound Alert Transports (Optional)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.mailgun.org
SMTP_PASS=your-smtp-password
SMTP_FROM="RicozViz Alerts <alerts@your-domain.io>"
SLACK_WEBHOOK_URL=
