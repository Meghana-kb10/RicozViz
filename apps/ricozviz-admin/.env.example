# ==============================================================================
# RicozViz Operator Admin Portal — Environment Configuration
# ==============================================================================
# Port: 3002
# SECURITY CRITICAL:
# - JWT_ADMIN_SECRET is consumed SOLELY on the Next.js server / Edge middleware.
# - It must NEVER be prefixed with NEXT_PUBLIC_ or bundled into client components.
# - Admin sessions use HttpOnly rv_admin_session cookie with mandatory TOTP 2FA.
# ==============================================================================

PORT=3002
NODE_ENV=production

# Server-Side Platform Admin JWT Verification Key (Strictly Server-Only)
JWT_ADMIN_SECRET=c1b33bb340e34b62e9e9370df7dbf760c020f0e27b85b5612bf629e8d6874799

# Upstream Backend API Origin (Server-side routing & CSP connect-src)
ADMIN_API_ORIGIN=http://localhost:4000

# Public API Gateway (Client fetch calls)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="RicozViz Admin Console"
