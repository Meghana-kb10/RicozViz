# ==============================================================================
# RicozViz Customer Analytics Portal — Environment Configuration
# ==============================================================================
# Port: 3001
# Customer sessions use the HttpOnly rv_customer_session cookie for refresh tokens.
# Client-side access token is stored strictly in memory.
# ==============================================================================

PORT=3001
NODE_ENV=production

# Public API Gateway (Browser client accessible)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="RicozViz Customer"

# Optional analytics & error tracking
NEXT_PUBLIC_ENV=production
