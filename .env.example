# ==============================================================================
# RicozViz Production Monorepo — Environment Variables & Secrets Manifest
# ==============================================================================
# SECURITY NOTICE:
# - NEVER commit populated .env files containing production secrets to git.
# - Generate 256-bit cryptographic keys using: openssl rand -hex 32
# - In test environments (NODE_ENV=test), MONGODB_URI database name MUST end with '_test'.
#   The backend kernel asserts this invariant and refuses to boot otherwise.
# - JWT_ADMIN_SECRET is strictly backend and server-side Next.js middleware only.
#   NEVER prefix with NEXT_PUBLIC_ or bundle it into browser-facing code.
# ==============================================================================

# Core Runtime
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Database Infrastructure (Primary MongoDB 7.0 + In-Memory DuckDB OLAP)
MONGODB_URI=mongodb://127.0.0.1:27017/ricozviz
MONGODB_DB_NAME=ricozviz
# For automated tests, use: mongodb://127.0.0.1:27017/ricozviz_test

# Cache, Rate Limiting & Queue Infrastructure (Redis 7)
REDIS_URL=redis://127.0.0.1:6379

# Cross-Origin Resource Sharing (CORS) & Applications
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://ricozviz.localhost,http://admin.ricozviz.localhost,https://ricozviz.localhost,https://admin.ricozviz.localhost
WEB_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002

# Customer Zero-Trust JWT Authentication Secrets
# openssl rand -hex 32
JWT_SECRET=super_secret_jwt_key_at_least_32_bytes_long_customer_prod
JWT_ACCESS_SECRET=super_secret_jwt_key_at_least_32_bytes_long_customer_prod
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_bytes_long_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Isolated Platform Admin JWT Authentication Secrets (aud: "admin")
# openssl rand -hex 32
JWT_ADMIN_SECRET=c1b33bb340e34b62e9e9370df7dbf760c020f0e27b85b5612bf629e8d6874799

# Credential Encryption at Rest (AES-256-GCM Envelope Encryption)
ENCRYPTION_MASTER_KEY_V1=f4b321a5c689de701234567890abcdef1234567890abcdef1234567890abcdef
ACTIVE_ENCRYPTION_KEY_VERSION=1
CREDENTIAL_ENC_KEY=f4b321a5c689de701234567890abcdef1234567890abcdef1234567890abcdef
CREDENTIAL_ENC_KEY_VERSION=1
CREDENTIAL_ENC_KEYS_PREVIOUS=

# Next.js Public Client Configuration (Safe for browser delivery)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="RicozViz Enterprise"
