# ========================================
# RicozViz — Environment Variables
# ========================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file — it is gitignored.
# ========================================

# ---- Node / General ----
NODE_ENV=development

# ---- API Server ----
PORT=4000

# ---- Database (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://ricozviz:ricozviz_dev_password@localhost:5432/ricozviz_db?schema=public

# ---- PostgreSQL (used by Docker Compose) ----
POSTGRES_USER=ricozviz
POSTGRES_PASSWORD=ricozviz_dev_password
POSTGRES_DB=ricozviz_db
POSTGRES_PORT=5432

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000
