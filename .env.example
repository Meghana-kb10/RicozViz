# ========================================
# RicozViz — Environment Variables Template
# ========================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file — it is gitignored.
# ========================================

# ---- Node / General ----
NODE_ENV=development

# ---- API Server ----
PORT=4000

# ---- Database (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://ricozviz:CHANGE_ME@localhost:5432/ricozviz_db?schema=public

# ---- PostgreSQL (used by Docker Compose) ----
POSTGRES_USER=ricozviz
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ricozviz_db
POSTGRES_PORT=5432

# ---- Authentication (JWT) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_crypto_randomBytes_64_hex
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_crypto_randomBytes_64_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000
