# ==============================================================================
# RicozViz Monorepo Environment Configuration
# ==============================================================================

# Backend Port & Host
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ricozviz
MONGODB_DB_NAME=ricozviz

# CORS & Web URLs (Customer: 3001, Admin: 3002)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
WEB_APP_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:3002

# Zero-Trust Customer JWT Authentication Secrets
JWT_SECRET=your-32-byte-secret-here-replace-with-openssl-rand-hex-32
JWT_ACCESS_SECRET=your-32-byte-access-secret-replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=your-32-byte-refresh-secret-replace-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Isolated Platform Admin JWT Authentication Secrets
JWT_ADMIN_SECRET=your-32-byte-admin-jwt-secret-replace-with-openssl-rand-hex-32

# Credential Encryption at Rest (AES-256-GCM)
CREDENTIAL_ENC_KEY=your-64-character-hex-encryption-key-for-aes-256-gcm-at-rest
CREDENTIAL_ENC_KEY_VERSION=1
CREDENTIAL_ENC_KEYS_PREVIOUS=
